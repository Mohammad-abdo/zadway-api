// Combined schema from prisma/modules/*.prisma
// _base.prisma + users + admin + driver + order + produc + ride + booking + notification + support + banner + withdraw + seeting

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── users.prisma ───────────────────────────────────────────────────────────

model User {
  id                       Int       @id @default(autoincrement())
  name                     String?   @map("first_name")
  email                    String?   @unique
  password                 String?
  countryCode              String?   @default("+1") @map("country_code")
  phone                    Int?      @unique @map("phone")
  userType                 String?   @map("user_type") @db.VarChar(20)
  uid                      String?
  loginType                String?   @map("login_type")
  displayName              String?   @map("display_name")
  status                   String    @default("pending") @db.VarChar(20)
  isOnline                 Boolean   @default(false) @map("is_online")
  isAvailable              Boolean   @default(false) @map("is_available")
  isVerified               Boolean   @default(false) @map("is_verified")
  latitude                 String?
  longitude                String?
  currentHeading           Float?    @map("current_heading")
  lastLocationUpdateAt     DateTime? @map("last_location_update_at") @db.Timestamp
  lastActivedAt            DateTime? @map("last_actived_at") @db.Timestamp
  referralCode             String?   @unique @map("referral_code")
  otp                      String?   @db.VarChar(10)
  otpExpiresAt             DateTime? @map("otp_expires_at") @db.Timestamp
  appVersion               String?   @map("app_version")
  avatar                   String?   @db.Text
  driverRejectionCount     Int       @default(0) @map("driver_rejection_count")
  rejectionReason          String?   @map("rejection_reason") @db.Text
  lastRejectionAt          DateTime? @map("last_rejection_at") @db.Timestamp
  pushNotificationsEnabled Boolean   @default(true) @map("push_notifications_enabled")
  createdAt                DateTime  @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt                DateTime  @default(now()) @updatedAt @map("updated_at") @db.DateTime(6)

  wallet          Wallet?
  walletHistories WalletHistory[]
  userRoles       UserRole[]

  ProductOrdersAsDriver  ProductOrder[]               @relation("ProductOrderDriver")
  ProductOrdersAsRider ProductOrder[]               @relation("ProductOrderRider")
  ProductInventoryItems  DriverInventoryItem[]
  ProductLocationUpdates ProductOrderLocationUpdate[]
  ProductOrderOffers     ProductOrderOffer[]
  inventoryLogs          InventoryLog[]
  paymentsAsUser         Payment[]                    @relation("PaymentUser")
  paymentsAsDriver       Payment[]                    @relation("PaymentDriver")

  driverDocuments         DriverDocument[]
  driverComplaints        Complaint[]         @relation("DriverComplaints")
  riderComplaints         Complaint[]         @relation("RiderComplaints")
  rideRequestBidsAsDriver RideRequestBid[]
  riderRatings            RideRequestRating[] @relation("RiderRatings")
  driverRatings           RideRequestRating[] @relation("DriverRatings")
  withdrawRequests        WithdrawRequest[]
  detail                  UserDetail?
  customerSupports        CustomerSupport[]
  adminLoginDevices       AdminLoginDevice[]
  addresses               UserAddress[]
  bankCards               UserBankCard[]

  @@index([userType, status])
  @@index([email])
  @@index([phone])
  @@map("users")
}

model Permission {
  id        Int      @id @default(autoincrement())
  name      String
  guardName String   @default("web") @map("guard_name")
  parentId  Int?     @map("parent_id")
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(6)

  parent          Permission?      @relation("PermissionParent", fields: [parentId], references: [id])
  subpermissions  Permission[]     @relation("PermissionParent")
  rolePermissions RolePermission[]

  @@unique([name, guardName])
  @@index([guardName])
  @@index([parentId])
  @@map("permissions")
}

model Role {
  id        Int      @id @default(autoincrement())
  name      String
  guardName String   @default("web") @map("guard_name")
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(6)

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([name, guardName])
  @@index([guardName])
  @@map("roles")
}

model RolePermission {
  id           Int      @id @default(autoincrement())
  roleId       Int      @map("role_id")
  permissionId Int      @map("permission_id")
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(6)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  roleId    Int      @map("role_id")
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

model Wallet {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique @map("user_id")
  balance   Float    @default(0) @db.Double
  currency  String   @default("SAR")
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(6)

  user      User            @relation(fields: [userId], references: [id])
  histories WalletHistory[]

  @@map("wallets")
}

model WalletHistory {
  id              Int      @id @default(autoincrement())
  walletId        Int      @map("wallet_id")
  userId          Int      @map("user_id")
  ProductOrderId  Int?     @map("Product_order_id")
  type            String
  amount          Float    @db.Double
  balance         Float    @db.Double
  description     String?  @db.Text
  transactionType String   @map("transaction_type")
  createdAt       DateTime @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(6)

  wallet       Wallet        @relation(fields: [walletId], references: [id])
  user         User          @relation(fields: [userId], references: [id])
  ProductOrder ProductOrder? @relation(fields: [ProductOrderId], references: [id])

  @@index([walletId])
  @@index([userId])
  @@index([ProductOrderId])
  @@map("wallet_histories")
}

model Review {
  id            Int      @id @default(autoincrement())
  driverId      Int      @map("driver_id")
  riderId       Int      @map("rider_id")
  rideRequestId Int      @map("ride_request_id")
  driverRating  Float?   @map("driver_rating") @db.Double
  riderRating   Float?   @map("rider_rating") @db.Double
  driverReview  String?  @map("driver_review") @db.Text
  driverReviewI18n Json? @map("driver_review_i18n")
  riderReview   String?  @map("rider_review") @db.Text
  riderReviewI18n Json?  @map("rider_review_i18n")
  createdAt     DateTime @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(6)

  @@index([driverId])
  @@index([riderId])
  @@index([rideRequestId])
  @@map("reviews")
}

model UserAddress {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  title     String?
  titleI18n Json?    @map("title_i18n")
  address   String?  @db.Text
  addressI18n Json?  @map("address_i18n")
  latitude  String?
  longitude String?
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_addresses")
}

model UserBankCard {
  id             Int      @id @default(autoincrement())
  userId         Int      @map("user_id")
  cardHolderName String?  @map("card_holder_name") @db.VarChar(100)
  lastFourDigits String   @map("last_four_digits") @db.VarChar(4)
  brand          String?  @db.VarChar(20)
  expiryMonth    Int?     @map("expiry_month")
  expiryYear     Int?     @map("expiry_year")
  isDefault      Boolean  @default(false) @map("is_default")
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_bank_cards")
}

model Complaint {
  id        Int      @id @default(autoincrement())
  driverId  Int      @map("driver_id")
  riderId   Int      @map("rider_id")
  message   String?  @db.Text
  messageI18n Json?  @map("message_i18n")
  status    String?  @default("pending") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(6)

  driver User @relation("DriverComplaints", fields: [driverId], references: [id])
  rider  User @relation("RiderComplaints", fields: [riderId], references: [id])

  @@index([driverId])
  @@index([riderId])
  @@map("complaints")
}

// ─── admin.prisma ─────────────────────────────────────────────────────────────

model AdminLoginDevice {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  ipAddress String?   @map("ip_address")
  userAgent String?   @map("user_agent")
  loginAt   DateTime? @map("login_at") @db.Timestamp(0)
  logoutAt  DateTime? @map("logout_at") @db.Timestamp(0)
  isActive  Boolean   @default(true) @map("is_active")
  sessionId String?   @map("session_id")
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.DateTime(6)
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("admin_login_devices")
}

model AdminLoginHistory {
  id              Int      @id @default(autoincrement())
  userId          Int?     @map("user_id")
  ipAddress       String?  @map("ip_address")
  city            String?
  region          String?
  country         String?
  latLong         String?  @map("lat_long")
  org             String?
  postalCode      String?  @map("postal_code")
  timezone        String?
  browser         String?
  browserVersion  String?  @map("browser_version")
  platform        String?
  platformVersion String?  @map("platform_version")
  device          String?
  isMobile        Boolean  @default(false) @map("is_mobile")
  isDesktop       Boolean  @default(false) @map("is_desktop")
  isTablet        Boolean  @default(false) @map("is_tablet")
  createdAt       DateTime @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(6)

  @@index([userId])
  @@map("admin_login_history")
}

model AdminSetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique @db.VarChar(128)
  value     String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(6)

  @@map("admin_settings")
}

// ─── driver.prisma ──────────────────────────────────────────────────────────

model Document {
  id            Int      @id @default(autoincrement())
  name          String
  nameAr        String?  @map("name_ar") @db.Text
  nameI18n      Json?    @map("name_i18n")
  type          String?
  status        Int      @default(1)
  isRequired    Boolean  @default(false) @map("is_required")
  hasExpiryDate Boolean  @default(false) @map("has_expiry_date")
  createdAt     DateTime @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(6)

  driverDocuments DriverDocument[]

  @@map("documents")
}

model DriverDocument {
  id            Int       @id @default(autoincrement())
  driverId      Int       @map("driver_id")
  documentId    Int       @map("document_id")
  isVerified    Boolean   @default(false) @map("is_verified")
  documentImage String?   @map("document_image") @db.Text
  expireDate    DateTime? @map("expire_date") @db.Date
  createdAt     DateTime  @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.DateTime(6)

  driver   User     @relation(fields: [driverId], references: [id])
  document Document @relation(fields: [documentId], references: [id])

  @@index([driverId])
  @@index([documentId])
  @@map("driver_documents")
}

model UserDetail {
  id                Int      @id @default(autoincrement())
  userId            Int      @unique @map("user_id")
  carModel          String?  @map("car_model")
  carColor          String?  @map("car_color")
  carPlateNumber    String?  @map("car_plate_number")
  carProductionYear Int?     @map("car_production_year")
  carImage          String?  @map("car_image")
  workAddress       String?  @map("work_address")
  homeAddress       String?  @map("home_address")
  workLatitude      String?  @map("work_latitude")
  workLongitude     String?  @map("work_longitude")
  homeLatitude      String?  @map("home_latitude")
  homeLongitude     String?  @map("home_longitude")
  createdAt         DateTime @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(6)

  user User @relation(fields: [userId], references: [id])

  @@map("user_details")
}

// ─── order.prisma ─────────────────────────────────────────────────────────────

enum ProductOrderStatus {
  NEW
  PENDING
  ACCEPTED
  PICKED_UP
  ON_THE_WAY
  REJECTED
  DELIVERED
  CANCELLED
}

enum ProductPaymentMethod {
  CASH
}

enum ProductOfferStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum OrderStatus {
  NEW
  OFFERED
  ACCEPTED
  PICKED_UP
  DELIVERING
  DELIVERED
  CANCELLED
}

model GuestCustomer {
  id        Int      @id @default(autoincrement())
  name      String?
  phone     String?
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(6)

  orders ProductOrder[]

  @@map("guest_customers")
}

model ProductOrder {
  id            Int                 @id @default(autoincrement())
  guestId       Int                 @map("guest_id")
  driverId      Int?                @map("driver_id")
  riderUserId   Int?                @map("rider_user_id")
  accessToken   String?             @unique @map("access_token") @db.VarChar(64)
  status        ProductOrderStatus  @default(NEW)
  paymentMethod ProductPaymentMethod @default(CASH) @map("payment_method")

  dropoffLat   Float   @map("dropoff_lat") @db.Double
  dropoffLng   Float   @map("dropoff_lng") @db.Double
  dropoffNotes String? @map("dropoff_notes") @db.Text
  dropoffNotesI18n Json? @map("dropoff_notes_i18n")

  subtotal      Float  @default(0) @db.Double
  commissionPct Float  @default(0) @map("commission_pct") @db.Double
  commissionAmt Float  @default(0) @map("commission_amt") @db.Double
  total         Float  @default(0) @db.Double
  currency      String @default("SAR") @db.VarChar(8)

  assignedAt  DateTime? @map("assigned_at") @db.Timestamp(0)
  deliveredAt DateTime? @map("delivered_at") @db.Timestamp(0)
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamp(0)
  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.DateTime(6)

  guest           GuestCustomer              @relation(fields: [guestId], references: [id])
  rider           User?                      @relation("ProductOrderRider", fields: [riderUserId], references: [id])
  driver          User?                      @relation("ProductOrderDriver", fields: [driverId], references: [id])
  items           ProductOrderItem[]
  offers          ProductOrderOffer[]
  payments        Payment[]
  walletHistories WalletHistory[]
  locationUpdates ProductOrderLocationUpdate[]

  @@index([guestId, status])
  @@index([driverId, status])
  @@index([riderUserId, status])
  @@index([status])
  @@map("Product_orders")
}

model ProductOrderItem {
  id        Int   @id @default(autoincrement())
  orderId   Int   @map("order_id")
  variantId Int   @map("variant_id")
  quantity  Int
  unitPrice Float @map("unit_price") @db.Double
  lineTotal Float @map("line_total") @db.Double

  order   ProductOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([variantId])
  @@map("Product_order_items")
}

model DriverInventoryItem {
  id             Int      @id @default(autoincrement())
  driverId       Int      @map("driver_id")
  variantId      Int      @map("variant_id")
  quantityOnHand Int      @default(0) @map("quantity_on_hand")
  price          Float    @db.Double
  currency       String   @default("SAR") @db.VarChar(8)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(6)

  driver  User           @relation(fields: [driverId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([driverId, variantId])
  @@index([driverId])
  @@index([variantId])
  @@map("driver_inventory_items")
}

model ProductOrderOffer {
  id           Int               @id @default(autoincrement())
  orderId      Int               @map("order_id")
  driverId     Int               @map("driver_id")
  offeredPrice Float?            @map("offered_price") @db.Double
  status       ProductOfferStatus @default(PENDING)
  createdAt    DateTime          @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt    DateTime          @default(now()) @updatedAt @map("updated_at") @db.DateTime(6)

  order  ProductOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  driver User         @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@unique([orderId, driverId])
  @@index([orderId, status])
  @@index([driverId, status])
  @@map("Product_order_offers")
}

model Payment {
  id             Int      @id @default(autoincrement())
  ProductOrderId Int      @map("Product_order_id")
  userId         Int      @map("user_id")
  driverId       Int      @map("driver_id")
  amount         Float    @db.Double
  paymentType    String   @map("payment_type")
  paymentStatus  String   @default("pending") @map("payment_status") @db.VarChar(20)
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(6)

  ProductOrder ProductOrder @relation(fields: [ProductOrderId], references: [id], onDelete: Cascade)
  user         User         @relation("PaymentUser", fields: [userId], references: [id])
  driver       User         @relation("PaymentDriver", fields: [driverId], references: [id])

  @@index([ProductOrderId])
  @@index([userId])
  @@index([driverId])
  @@index([paymentStatus])
  @@map("payments")
}

model InventoryLog {
  id        Int      @id @default(autoincrement())
  driverId  Int      @map("driver_id")
  variantId Int      @map("variant_id")
  change    Int
  reason    String   @db.VarChar(191)
  reasonI18n Json?   @map("reason_i18n")
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(6)

  driver  User           @relation(fields: [driverId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([driverId, createdAt])
  @@index([variantId, createdAt])
  @@map("inventory_logs")
}

model ProductOrderLocationUpdate {
  id        Int      @id @default(autoincrement())
  orderId   Int      @map("order_id")
  driverId  Int      @map("driver_id")
  lat       Float    @db.Double
  lng       Float    @db.Double
  heading   Float?   @db.Double
  speed     Float?   @db.Double
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(6)

  order  ProductOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  driver User         @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@index([driverId, createdAt])
  @@map("Product_order_location_updates")
}

// ─── produc.prisma ────────────────────────────────────────────────────────────

enum DiscountType {
  PERCENTAGE
  FIXED
}

model Category {
  id          Int      @id @default(autoincrement())
  name        String
  nameI18n    Json?    @map("name_i18n")
  description String?
  descriptionI18n Json? @map("description_i18n")
  image_url   String?
  products    Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  nameI18n    Json?    @map("name_i18n")
  description String?
  descriptionI18n Json? @map("description_i18n")
  categoryId  Int
  imageUrl    String
  images      Json?
  variants    ProductVariant[]
  banners     Banner[]
  isActive    Boolean  @default(true) @map("is_active")
  category    Category @relation(fields: [categoryId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())

  @@index([isActive])
}

model ProductType {
  id     Int     @id @default(autoincrement())
  name   String  @default("")
  nameAr String? @map("name_ar") @db.Text
  nameI18n Json? @map("name_i18n")

  variants  ProductVariant[]
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
}

model Size {
  id     Int     @id @default(autoincrement())
  name   String  @default("")
  nameAr String? @map("name_ar") @db.Text
  nameI18n Json? @map("name_i18n")

  variants  ProductVariant[]
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
}

model ProductVariant {
  id        Int     @id @default(autoincrement())
  productId Int
  sizeId    Int
  typeId    Int
  price     Decimal @db.Decimal(10, 2)
  stock     Int     @default(0)
  sku       String? @unique
  /// Hero image for this size/type combo; falls back to `Product.imageUrl` in API when null.
  imageUrl  String? @db.VarChar(512)
  /// Extra gallery URLs (JSON array); falls back to `Product.images` in API when null/empty.
  images    Json?

  product Product     @relation(fields: [productId], references: [id])
  size    Size        @relation(fields: [sizeId], references: [id])
  type    ProductType @relation(fields: [typeId], references: [id])

  orderItems           ProductOrderItem[]
  driverInventoryItems DriverInventoryItem[]
  inventoryLogs        InventoryLog[]

  currency  String   @default("IQD") @db.VarChar(8) //دينار  عراقي
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  @@unique([productId, sizeId, typeId])
}

model Coupon {
  id                 Int       @id @default(autoincrement())
  code               String?   @unique
  title              String?
  titleAr            String?   @map("title_ar") @db.Text
  titleI18n           Json?     @map("title_i18n")
  couponType         String?   @map("coupon_type")
  usageLimitPerRider Int?      @map("usage_limit_per_rider")
  discountType       String?   @map("discount_type")
  discount           Float?    @db.Double
  startDate          DateTime? @map("start_date") @db.Date
  endDate            DateTime? @map("end_date") @db.Date
  minimumAmount      Float?    @map("minimum_amount") @db.Double
  maximumDiscount    Float?    @map("maximum_discount") @db.Double
  status             Int?
  description        String?   @db.Text
  descriptionAr      String?   @map("description_ar") @db.Text
  descriptionI18n     Json?     @map("description_i18n")
  imageUrl           String?   @map("image_url") @db.VarChar(512)
  regionIds          String?   @map("region_ids") @db.Text
  serviceIds         Json?     @map("service_ids")
  createdAt          DateTime  @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.DateTime(6)

  @@map("coupons")
}

// ─── ride.prisma ──────────────────────────────────────────────────────────────

model RideRequestBid {
  id            Int      @id @default(autoincrement())
  rideRequestId Int      @map("ride_request_id")
  driverId      Int      @map("driver_id")
  bidAmount     Float?   @map("bid_amount") @db.Double
  isBidAccept   Boolean  @default(false) @map("is_bid_accept")
  notes         String?  @db.Text
  notesI18n     Json?    @map("notes_i18n")
  createdAt     DateTime @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(6)

  driver User @relation(fields: [driverId], references: [id])

  @@index([rideRequestId])
  @@index([driverId])
  @@map("ride_request_bids")
}

model RideRequestRating {
  id            Int      @id @default(autoincrement())
  rideRequestId Int      @map("ride_request_id")
  riderId       Int      @map("rider_id")
  driverId      Int      @map("driver_id")
  rating        Float    @db.Double
  comment       String?  @db.Text
  commentI18n   Json?    @map("comment_i18n")
  ratingBy      String?  @map("rating_by")
  createdAt     DateTime @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(6)
  rider         User     @relation("RiderRatings", fields: [riderId], references: [id])
  driver        User     @relation("DriverRatings", fields: [driverId], references: [id])

  @@index([rideRequestId])
  @@index([riderId])
  @@index([driverId])
  @@map("ride_request_ratings")
}

model RideRequestHistory {
  id            Int       @id @default(autoincrement())
  rideRequestId Int       @map("ride_request_id")
  historyType   String?   @map("history_type")
  historyTypeI18n Json?   @map("history_type_i18n")
  datetime      DateTime? @db.Timestamp(0)
  createdAt     DateTime  @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.DateTime(6)

  @@index([rideRequestId])
  @@map("ride_request_histories")
}

// ─── booking.prisma ───────────────────────────────────────────────────────────

model BookingInvoice {
  id        Int       @id @default(autoincrement())
